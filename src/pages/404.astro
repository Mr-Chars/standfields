---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import { MAIN_NAV } from '@/data/navigation';
import { ROUTES } from '@/config/routes';
import { CONTACT, WHATSAPP } from '@/config/site';
---

<BaseLayout
  path="/404/"
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de dirección."
  noindex
>
  <Section space="lg" ariaLabelledby="error-404">
    <p class="eyebrow">Error 404</p>
    <h1 class="page-title error__title" id="error-404">Esta página no existe</h1>
    <p class="lead measure error__text">
      Puede que el enlace esté mal escrito o que la página haya cambiado de dirección.
      Desde aquí llegas a cualquier sección del sitio.
    </p>

    <div class="actions error__actions">
      <Button href={ROUTES.home} variant="primary" size="lg" iconAfter="arrow-right">
        Volver a la portada
      </Button>
      <Button
        href={WHATSAPP.general}
        variant="outline"
        size="lg"
        iconBefore="whatsapp"
        external
      >
        WhatsApp {CONTACT.phoneDisplay}
      </Button>
    </div>

    <nav class="error__nav" aria-label="Secciones del sitio">
      <h2 class="error__nav-title">Todas las secciones</h2>
      <ul>
        {
          MAIN_NAV.flatMap((item) => [
            <li>
              <a href={item.href}>{item.label}</a>
            </li>,
            ...(item.children ?? []).map((child) => (
              <li>
                <a href={child.href}>{child.label}</a>
              </li>
            )),
          ])
        }
        <li><a href={ROUTES.contacto}>Contacto</a></li>
      </ul>
    </nav>
  </Section>
</BaseLayout>

<style>
  .error__title {
    margin-bottom: 20px;
    max-width: 16ch;
  }

  .error__text {
    margin-bottom: 32px;
    --measure: 52ch;
  }

  .error__actions {
    margin-bottom: clamp(48px, 6vw, 80px);
  }

  .error__nav {
    padding-top: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--border-subtle);
  }

  .error__nav-title {
    margin-bottom: 18px;
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: var(--fw-extrabold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-secondary);
  }

  .error__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }

  .error__nav a {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: 15px;
    color: var(--brand-primary);
  }

  .error__nav a:hover {
    color: var(--brand-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
