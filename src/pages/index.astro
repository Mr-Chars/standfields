---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { Image } from 'astro:assets';
import ordersPanel from '@/assets/sass-naix-vista-ordenes.png';
import HeroParticles from '@/components/sections/HeroParticles.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
import { ROUTES } from '@/config/routes';
import { CONTACT, SITE, WHATSAPP } from '@/config/site';
import {
  heroStats,
  intro,
  process,
  productDetail,
  recentWork,
  saasCard,
  shopifyCard,
  shopifyServices,
  testimonial,
} from '@/data/home';
---

<BaseLayout
  active="home"
  path="/"
  title={SITE.tagline}
  description={SITE.description}
>
  <HeroParticles />

  {/* 01 — Qué hacemos, con la franja de datos al pie de la sección. */}
  <section class="section section--hairline" style="--py: clamp(56px, 6vw, 100px)">
    <div class="container">
      <div class="grid-auto" style="--min: 300px; --gap: clamp(24px, 4vw, 64px); --align: start">
        <div>
          <span class="eyebrow">{intro.eyebrow}</span>
          <h2 class="section-title" style="--fs: clamp(28px, 3.6vw, 46px)">{intro.title}</h2>
        </div>
        <div class="intro__aside">
          <p class="prose measure" style="--measure: 46ch">{intro.text}</p>
          <a class="link-arrow" href={intro.link.href}>
            {intro.link.label}
            <Icon name="arrow-right" size={15} />
          </a>
        </div>
      </div>
    </div>

    <div class="stat-band">
      <div class="container stat-band__inner">
        <dl class="stat-strip">
          {
            heroStats.map((stat) => (
              <div class="stat">
                <dt class="stat__value">{stat.value}</dt>
                <dd class="stat__label">{stat.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* Dos líneas de negocio */}
  <Section hairline ariaLabel="Nuestras dos líneas de negocio">
    <div class="grid-auto" style="--min: 340px; --gap: clamp(18px, 2vw, 26px)">
      <article class="card card--navy on-dark lines__card">
        <span class="eyebrow">{saasCard.eyebrow}</span>
        <h2 class="card-title" style="--fs: clamp(27px, 3.2vw, 40px)">{saasCard.title}</h2>
        <p class="note measure" style="--measure: 44ch">{saasCard.text}</p>
        <ul class="check-list">
          {
            saasCard.features.map((feature) => (
              <li class="check-list__item">
                <Icon name="check" size={18} />
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
        <div class="actions">
          <Button href={saasCard.actions.primary.href} variant="secondary" iconAfter="arrow-right">
            {saasCard.actions.primary.label}
          </Button>
          <Button href={saasCard.actions.secondary.href} variant="outline-on-dark">
            {saasCard.actions.secondary.label}
          </Button>
        </div>
      </article>

      <article class="card card--cream card--flat lines__card">
        <span class="eyebrow">{shopifyCard.eyebrow}</span>
        <h2 class="card-title" style="--fs: clamp(27px, 3.2vw, 40px)">{shopifyCard.title}</h2>
        <p class="prose measure" style="--measure: 44ch">{shopifyCard.text}</p>
        <ul class="row-links">
          {
            shopifyCard.links.map((link) => (
              <li>
                <a href={link.href}>
                  <span>{link.label}</span>
                  <Icon name="arrow-right" size={17} />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="actions">
          <Button href={WHATSAPP.shopify} variant="primary" iconBefore="whatsapp" external>
            Escríbenos por WhatsApp
          </Button>
          <Button href={ROUTES.serviciosShopify} variant="outline">Ver servicios</Button>
        </div>
      </article>
    </div>
  </Section>

  {/* 02 — El producto por dentro */}
  <Section hairline ariaLabel="El producto por dentro">
    <span class="eyebrow">{productDetail.eyebrow}</span>
    <div class="grid-auto" style="--min: 320px; --gap: clamp(28px, 4vw, 56px); --align: start">
      <div>
        <h2 class="section-title detail__title">{productDetail.title}</h2>
        <p class="prose measure detail__text">{productDetail.text}</p>
        <ol class="numbered-list">
          {
            productDetail.modules.map((module, index) => (
              <li class="numbered-list__item">
                <span class="numbered-list__index">{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <span class="numbered-list__title">{module.title}</span>
                  <span class="numbered-list__text">{module.text}</span>
                </div>
              </li>
            ))
          }
        </ol>
        <Button
          href={productDetail.link.href}
          variant="secondary"
          iconAfter="arrow-right"
          class="detail__cta"
        >
          {productDetail.link.label}
        </Button>
      </div>

      <figure class="panel">
        <figcaption class="panel__caption">
          <span class="panel__dot" aria-hidden="true"></span>
          {productDetail.panelCaption}
        </figcaption>
        <Image
          src={ordersPanel}
          alt={productDetail.panelAlt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 900px) 46vw, 92vw"
          loading="lazy"
          class="panel__slot"
        />
      </figure>
    </div>
  </Section>

  {/* 03 — Servicios Shopify */}
  <Section tone="cream" hairline ariaLabelledby="servicios-shopify">
    <span class="eyebrow">03 — Servicios Shopify</span>
    <h2 class="section-title services__title" id="servicios-shopify">
      Tres formas de trabajar tu tienda
    </h2>
    <div class="grid-auto" style="--min: 280px">
      {
        shopifyServices.map((service) => (
          <a class="card service-card" href={service.href}>
            <Icon name={service.icon} size={28} strokeWidth={2} class="service-card__icon" />
            <h3 class="card-title">{service.title}</h3>
            <p class="note">{service.text}</p>
            <span class="service-card__more">
              Ver el servicio
              <Icon name="arrow-right" size={14} />
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  {/* 04 — Trabajo reciente */}
  <Section hairline ariaLabelledby="trabajo-reciente">
    <div class="section-head">
      <div>
        <span class="eyebrow">04 — Trabajo reciente</span>
        <h2 class="section-title" id="trabajo-reciente">Algunos de nuestros proyectos</h2>
      </div>
      <a class="link-arrow" href={ROUTES.casos}>
        Ver todos los casos
        <Icon name="arrow-right" size={15} />
      </a>
    </div>
    <ul class="grid-auto work-grid" style="--min: 290px; --gap: clamp(20px, 2.5vw, 32px)">
      {
        recentWork.map((item) => (
          <li>
            <a class="card card--flat work-card" href={ROUTES.casos}>
              <span class="work-card__tag">{item.tag}</span>
              <h3 class="card-title" style="--fs: 20px">
                {item.title}
              </h3>
              <p class="note">{item.text}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* 05 — Cómo trabajamos */}
  <Section tone="cream" hairline ariaLabelledby="proceso">
    <span class="eyebrow">05 — Cómo trabajamos</span>
    <h2 class="section-title services__title" id="proceso">Un proceso corto, con entregas visibles</h2>
    <ol class="grid-auto" style="--min: 230px">
      {
        process.map((step) => (
          <li class="card card--cream process-card">
            <span class="process-card__step">{step.step}</span>
            <h3 class="card-title" style="--fs: 19px">
              {step.title}
            </h3>
            <p class="note">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  {/* Testimonio */}
  <Section tone="cream" hairline space="lg" ariaLabel="Testimonio de cliente">
    <div class="grid-auto" style="--min: 300px; --gap: clamp(28px, 4vw, 64px); --align: end">
      <blockquote class="quote">
        <p>{testimonial.quote}</p>
      </blockquote>
      <div class="quote__meta">
        <span class="quote__rule" aria-hidden="true"></span>
        <cite class="quote__author">{testimonial.author}</cite>
        <span class="quote__role">{testimonial.role}</span>
        <a class="link-arrow" href={testimonial.link.href}>
          {testimonial.link.label}
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>
  </Section>

  <CtaSection
    eyebrow="06 — Siguiente paso"
    title="Cuéntanos qué necesitas resolver."
    text="Si tienes un taller, empieza la prueba gratuita y móntalo tú mismo. Si vendes en línea, escríbenos por WhatsApp y lo revisamos contigo."
    primary={{ label: 'Probar Naix gratis', href: ROUTES.softwareTaller }}
    secondary={{
      label: `WhatsApp ${CONTACT.phoneDisplay}`,
      href: WHATSAPP.general,
      icon: 'whatsapp',
      external: true,
    }}
  />
</BaseLayout>

<style>
  .intro__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding-top: 6px;
  }

  /* Franja de datos: sangra a ancho completo bajo la sección. */
  .stat-band {
    margin-top: clamp(56px, 6vw, 100px);
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-highlight);
  }

  .stat-band__inner {
    padding-inline: 0;
  }

  /* <dl> con <div> intermedios: se anula el margen que el navegador da a <dd>. */
  .stat-strip :global(dd) {
    margin: 0;
  }

  .lines__card {
    --gap: 22px;
    --pad: clamp(40px, 5vw, 64px) clamp(24px, 4vw, 56px);
  }

  .row-links li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--border-subtle);
    font-size: 15px;
    font-weight: var(--fw-bold);
    color: var(--brand-primary);
  }

  .row-links li:last-child a {
    border-bottom: 1px solid var(--border-subtle);
  }

  .row-links li a:hover {
    color: var(--brand-secondary);
  }

  .detail__title {
    margin-bottom: 18px;
    --fs: clamp(27px, 3.4vw, 42px);
  }

  .detail__text {
    margin-bottom: 28px;
    --measure: 48ch;
  }

  .detail__cta {
    margin-top: 28px;
  }

  .panel {
    margin: 0;
    background: var(--bg-highlight);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .panel__caption {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 11.5px;
    font-weight: var(--fw-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-primary);
  }

  .panel__dot {
    width: 10px;
    height: 10px;
    background: var(--brand-primary);
  }

  /* La captura ocupa exactamente el hueco que reservaba el marcador (4/3), para
     que sustituirla no mueva el resto de la sección. */
  .panel :global(.panel__slot) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top center;
    border: 0;
    border-radius: 0;
    background: var(--cream-100);
  }

  .services__title {
    margin-bottom: clamp(28px, 4vw, 48px);
    max-width: 26ch;
    --fs: clamp(27px, 3.4vw, 42px);
  }

  .service-card {
    --gap: 14px;
    height: 100%;
  }

  .service-card__icon {
    color: var(--brand-secondary);
  }

  .service-card__more {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: auto;
    padding-top: 10px;
    font-family: var(--font-display);
    font-weight: var(--fw-extrabold);
    font-size: 13.5px;
    color: var(--brand-secondary);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .work-card {
    --gap: 10px;
    --pad: 22px 20px 24px;
    height: 100%;
  }

  .work-card__tag {
    font-size: 11.5px;
    font-weight: var(--fw-extrabold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--brand-secondary);
  }

  .process-card {
    --gap: 8px;
    --pad: clamp(26px, 3vw, 38px);
  }

  .process-card__step {
    margin-bottom: 6px;
    font-family: var(--font-display);
    font-weight: var(--fw-black);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-secondary);
  }

  .quote {
    margin: 0;
    max-width: 620px;
  }

  .quote p {
    font-family: var(--font-display);
    font-weight: var(--fw-extrabold);
    font-size: clamp(22px, 2.6vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--brand-primary);
  }

  .quote__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding-bottom: 6px;
  }

  .quote__rule {
    width: 64px;
    height: 2px;
    background: var(--brand-secondary);
    border-radius: 2px;
  }

  .quote__author {
    font-family: var(--font-display);
    font-weight: var(--fw-extrabold);
    font-size: 16px;
    font-style: normal;
    color: var(--brand-primary);
  }

  .quote__role {
    font-size: 14px;
    color: var(--text-soft);
  }

  .quote__meta .link-arrow {
    margin-top: 8px;
  }
</style>
