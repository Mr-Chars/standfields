---
/**
 * Iconografía del sitio.
 *
 * Todos los trazos son los del diseño de referencia: línea de 2–2.5, remates
 * cuadrados y `currentColor`, para que un icono tome siempre el color del texto
 * que acompaña. Se pintan en línea (no como <img>) para que no cuesten una
 * petición extra y hereden el color sin filtros CSS.
 *
 * Por defecto son decorativos (`aria-hidden`). Si un icono es la única etiqueta
 * de un control, pásale `title` y se expone como imagen accesible.
 */
export type IconName =
  | 'arrow-right'
  | 'check'
  | 'whatsapp'
  | 'plus'
  | 'close'
  | 'chevron-down'
  | 'menu'
  | 'mail'
  | 'briefcase'
  | 'storefront'
  | 'code'
  | 'grid-plus'
  | 'document'
  | 'user-plus'
  | 'car'
  | 'calendar'
  | 'chart-line'
  | 'card'
  | 'pulse'
  | 'layers'
  | 'sparkle'
  | 'panel'
  | 'bookmark'
  | 'chart-bar';

interface Props {
  name: IconName;
  /** Tamaño en píxeles; el icono siempre es cuadrado. */
  size?: number;
  strokeWidth?: number;
  /** Nombre accesible. Si se omite, el icono queda oculto para lectores. */
  title?: string;
  class?: string;
}

const { name, size = 16, strokeWidth = 2.5, title, class: className } = Astro.props;

const PATHS: Record<IconName, string> = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  whatsapp: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  close: '<path d="M18 6 6 18M6 6l12 12"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  mail: '<rect x="2" y="4" width="20" height="16"/><path d="m2 6 10 7 10-7"/>',
  briefcase: '<rect x="2" y="7" width="20" height="14"/><path d="M9 7V3h6v4"/>',
  storefront: '<path d="M3 9h18v12H3z"/><path d="M3 9l2-5h14l2 5"/><path d="M9 13h6"/>',
  code: '<path d="m8 6-6 6 6 6"/><path d="m16 6 6 6-6 6"/>',
  'grid-plus':
    '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>' +
    '<rect x="3" y="14" width="7" height="7"/><path d="M14 17.5h7M17.5 14v7"/>',
  document: '<path d="M4 3h11l5 5v13H4z"/><path d="M8 12h8M8 16h5"/>',
  'user-plus':
    '<path d="M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>' +
    '<path d="M17 4h5M19.5 1.5v5"/>',
  car:
    '<path d="M3 13h18l-2-6H5z"/><path d="M3 13v5h18v-5"/>' +
    '<circle cx="7.5" cy="18.5" r="1.5"/><circle cx="16.5" cy="18.5" r="1.5"/>',
  calendar: '<rect x="3" y="4" width="18" height="17"/><path d="M3 9h18M8 2v4M16 2v4"/>',
  'chart-line': '<path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/>',
  card: '<rect x="2" y="6" width="20" height="12"/><path d="M2 11h20M6 15h4"/>',
  pulse: '<path d="M3 12h6l2 5 2-10 2 5h6"/>',
  layers: '<path d="M4 4h16v6H4zM4 14h16v6H4z"/><path d="M8 7h.01M8 17h.01"/>',
  sparkle: '<path d="M12 3v4M12 17v4M3 12h4M17 12h4"/><circle cx="12" cy="12" r="4"/>',
  panel: '<rect x="3" y="3" width="18" height="18"/><path d="M3 9h18M9 9v12"/>',
  bookmark: '<path d="M5 3h14v18l-7-4-7 4z"/>',
  'chart-bar':
    '<path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="8"/><rect x="13" y="6" width="3" height="12"/>',
};

const labelled = Boolean(title);
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="square"
  class={className}
  role={labelled ? 'img' : undefined}
  aria-hidden={labelled ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <Fragment set:html={PATHS[name]} />
</svg>

<style>
  svg {
    flex-shrink: 0;
  }
</style>
