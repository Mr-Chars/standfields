# Cabeceras HTTP para Cloudflare Pages.
# Cloudflare lee este archivo desde la raíz del build y lo aplica por patrón de
# ruta. La regla más específica gana, así que las de assets van después de /*.

/*
  # Content-Security-Policy: aquí van las directivas que no dependen del
  # contenido de la página. `script-src` y `style-src` los emite Astro en un
  # <meta> por página, con el hash de cada script y estilo propios; ambas
  # políticas se aplican a la vez y el navegador exige pasar las dos.
  # Deliberadamente no se declara `default-src`: haría de respaldo para
  # `script-src` y bloquearía los scripts que el <meta> sí autoriza.
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; worker-src 'none'; media-src 'none'; manifest-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' https://wa.me; upgrade-insecure-requests

  # El sitio no se embebe en ningún iframe. `frame-ancestors` ya lo cubre en
  # navegadores modernos; esta cabecera es el respaldo para los antiguos.
  X-Frame-Options: DENY

  # Impide que el navegador adivine el tipo MIME de una respuesta.
  X-Content-Type-Options: nosniff

  # Se envía el origen a sitios externos, nunca la ruta completa.
  Referrer-Policy: strict-origin-when-cross-origin

  # El sitio no usa ninguna de estas capacidades del navegador.
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()

  # HSTS: dos años, subdominios incluidos. Activar sólo con el dominio ya
  # servido íntegramente por HTTPS (Cloudflare lo hace por defecto).
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # Aísla el sitio de otros documentos del mismo proceso del navegador.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Los assets con hash en el nombre no cambian nunca de contenido: se pueden
# cachear de forma indefinida.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Las fuentes tampoco cambian de contenido; se regeneran con `npm run fonts`
# sólo si se cambia de familia, y en ese caso también cambia el nombre.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/favicon.svg
  Cache-Control: public, max-age=604800

/og-default.png
  Cache-Control: public, max-age=604800
